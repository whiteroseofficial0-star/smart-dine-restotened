# Copy to .env — never commit .env
DATABASE_URL="postgresql://smartdine:smartdine_dev_password@localhost:5432/smartdine"
# Used to sign QR/order tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me"
# Public base URL printed inside QR codes (use your LAN IP so phones can reach it)
PUBLIC_BASE_URL="http://localhost:3000"
PORT=3000
# Demo mode: shows demo logins on /login and table links on / . MUST be "false" for a real restaurant.
NEXT_PUBLIC_DEMO_MODE="true"
