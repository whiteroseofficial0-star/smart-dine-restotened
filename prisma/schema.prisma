generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
  WAITER
}
enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}
enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}
enum PaymentMethod {
  COUNTER
  CASH
  UPI
  ONLINE
}
enum RequestType {
  ASSISTANCE
  WATER
  CUTLERY
  BILL
}
enum RequestStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  address   String
  phone     String?
  email     String?
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings   RestaurantSettings?
  users      User[]
  tables     DiningTable[]
  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]
  requests   StaffRequest[]
  notifications Notification[]
}

model RestaurantSettings {
  id             String   @id @default(cuid())
  restaurantId   String   @unique
  taxPercent     Decimal  @default(5) @db.Decimal(5, 2)
  serviceChargePercent Decimal @default(0) @db.Decimal(5, 2)
  openTime       String   @default("09:00")
  closeTime      String   @default("23:00")
  voiceEnabled   Boolean  @default(true)
  voiceLang      String   @default("en-IN")
  voiceRate      Float    @default(1)
  voiceVolume    Float    @default(1)
  announceTemplate String @default("Attention! New order received. Table {table}. Order number {order}. {items}.")
  kitchenWarnMinutes Int  @default(15)
  autoSendToKitchen Boolean @default(true)
  receiptFooter  String   @default("Thank you for dining with us!")
  gstin          String?
  updatedAt      DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions   Session[]
  statusChanges OrderStatusHistory[]

  @@index([restaurantId, role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DiningTable {
  id           String   @id @default(cuid())
  restaurantId String
  number       Int
  label        String
  qrToken      String   @unique
  qrActive     Boolean  @default(true)
  seats        Int      @default(4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]
  requests   StaffRequest[]

  @@unique([restaurantId, number])
}

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@unique([restaurantId, name])
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String   @default("")
  price        Decimal  @db.Decimal(10, 2)
  taxPercent   Decimal? @db.Decimal(5, 2)
  imageUrl     String?
  isVeg        Boolean  @default(true)
  available    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  options    MenuOption[]
  orderItems OrderItem[]

  @@index([restaurantId, categoryId, available])
}

// Variants (size, spice level) and add-ons share one table; `kind` separates them.
model MenuOption {
  id         String  @id @default(cuid())
  menuItemId String
  kind       String  // VARIANT | ADDON
  groupName  String  // e.g. "Size", "Spice level", "Extras"
  name       String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  available  Boolean @default(true)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  tableId       String
  orderNumber   Int
  publicToken   String        @unique // unguessable token the customer uses to track only this order
  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(UNPAID)
  customerName  String?
  customerPhone String?
  notes         String?
  rejectReason  String?
  kitchenSentAt DateTime?
  subtotal      Decimal       @db.Decimal(10, 2)
  taxTotal      Decimal       @db.Decimal(10, 2)
  serviceCharge Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable @relation(fields: [tableId], references: [id])
  items      OrderItem[]
  history    OrderStatusHistory[]
  payments   Payment[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status, createdAt])
  @@index([tableId, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  menuItemId   String?
  nameSnapshot String
  unitPrice    Decimal @db.Decimal(10, 2) // price incl. selected options, at order time
  taxPercent   Decimal @db.Decimal(5, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(10, 2)
  options      Json    @default("[]")
  instructions String?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus  OrderStatus
  userId    String?
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  method    PaymentMethod
  status    PaymentStatus
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  recordedBy String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model StaffRequest {
  id             String        @id @default(cuid())
  restaurantId   String
  tableId        String
  type           RequestType
  status         RequestStatus @default(OPEN)
  note           String?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime      @default(now())

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable @relation(fields: [tableId], references: [id])

  @@index([restaurantId, status])
}

model Notification {
  id           String   @id @default(cuid())
  restaurantId String
  kind         String   // NEW_ORDER | STAFF_REQUEST | ORDER_READY
  refId        String
  message      String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}
